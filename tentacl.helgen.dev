upstream tentacl_backend {
    server 127.0.0.1:8095;
}

server {
    server_name tentacl.helgen.dev;

    location / {
        proxy_pass         http://tentacl_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }

    listen [::]:443 ssl; 
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/tentacl.helgen.dev/fullchain.pem; 
    ssl_certificate_key /etc/letsencrypt/live/tentacl.helgen.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = tentacl.helgen.dev) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name tentacl.helgen.dev;
    return 404;
}
